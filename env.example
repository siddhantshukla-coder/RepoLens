# Copy this file to ".env" and fill it in.

# Your Groq key (used by the self-RAG graph and the documentation writer)
GROQ_API_KEY=

# Any long random string, it signs the login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Optional: a GitHub personal access token. Raises the API rate limit
# and lets RepoLens read private repos that token can access.
GITHUB_TOKEN=

# Optional: LangSmith tracing. With these set, every self-RAG run
# (each node, prompt and LLM call) shows up at https://smith.langchain.com
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=repolens
